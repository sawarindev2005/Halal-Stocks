# Port the Express server listens on
PORT=4000
# Origin of the web client allowed by CORS (also used for links in Discord messages)
CLIENT_ORIGIN=http://localhost:5173
# Discord webhook for price alerts — see docs/discord-webhook-setup.md
# Leave empty to store alerts without sending them
DISCORD_WEBHOOK_URL=
# How often to check alerts (cron syntax, default every 5 minutes)
# ALERT_CHECK_CRON=*/5 * * * *
# Where alert rules are stored (default server/data/alerts.sqlite)
# ALERTS_DB_PATH=

# ---------------------------------------------------------------------------
# ฐานข้อมูล MySQL (ไม่บังคับ)
# ว่างไว้ = ใช้ไฟล์ SQLite ใน server/data (เหมาะกับ npm run dev)
# docker compose ตั้งค่านี้ให้เองจาก MYSQL_* ด้านล่าง ไม่ต้องใส่
# DATABASE_URL=mysql://user:password@localhost:3306/shariah_watch

# ---------------------------------------------------------------------------
# สรุปข่าวประจำวัน — ดู server/src/news/README.md
# ใส่ key ของ AI ค่ายใดค่ายหนึ่ง (ว่างทั้งคู่ = ส่งแค่หัวข้อข่าว + ลิงก์)
# เลือกค่ายเองด้วย NEWS_AI_PROVIDER=claude หรือ gemini (ว่าง = ใช้ค่ายที่มี key, มีทั้งคู่ใช้ Claude)
# NEWS_AI_PROVIDER=
# Claude: key จาก https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Gemini: key จาก https://aistudio.google.com → Get API key (มีโควตาฟรี)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# Webhook ของห้อง Discord สำหรับข่าว (ว่างไว้ = ใช้ DISCORD_WEBHOOK_URL ห้องเดียวกับแจ้งเตือนราคา)
NEWS_DISCORD_WEBHOOK_URL=
# เวลาส่ง (cron) และเขตเวลา — ค่าเริ่มต้นทุกวัน 07:00 เวลาไทย
# NEWS_CRON=0 7 * * *
# NEWS_TIMEZONE=Asia/Bangkok
# โมเดลที่ใช้สรุป
# NEWS_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Docker (ใช้เฉพาะตอนรัน docker compose)
# รหัสผ่านใช้แค่ตัวอักษรและตัวเลข (เพราะถูกใส่ใน URL ของฐานข้อมูล)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=shariah_watch
# MYSQL_USER=shariah
# พอร์ตหน้าเว็บบนเครื่องคุณ และ URL ที่ใช้ในลิงก์ของข้อความ Discord
# WEB_PORT=8080
# PUBLIC_URL=http://localhost:8080

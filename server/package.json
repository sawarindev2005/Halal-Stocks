{
  "name": "shariah-stock-watch-server",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "news:once": "node --env-file-if-exists=../.env --import tsx src/news/runOnce.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^4.0.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
